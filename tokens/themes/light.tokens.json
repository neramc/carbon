{
  "$description": "CARBON Soft White theme (Light). Same token paths as the Soft Black theme; neither theme is secondary.",
  "color": {
    "$type": "color",
    "background": {"$value": "{color.soft-white.944}", "$description": "D0 Foundation fill."},
    "surface": {"$value": "{color.soft-white.972}", "$description": "D1 Integrated and D2 Raised fill."},
    "surface-secondary": {
      "$value": "{color.soft-white.937}",
      "$description": "Secondary regions within a Surface (headers, grouped areas). Not an elevation level."
    },
    "surface-elevated": {"$value": "{color.soft-white.983}", "$description": "D3 Floating and D4 Elevated fill; selected raised tiles."},
    "surface-inset": {"$value": "{color.soft-white.912}", "$description": "Recessed regions: input wells, tracks."},
    "border": {"$value": "{color.soft-white.880}", "$description": "Structural edges and dividers (decorative; below 3:1)."},
    "border-strong": {"$value": "{color.soft-white.809}", "$description": "Emphasized structural edges (decorative; below 3:1)."},
    "text-primary": {"$value": "{color.soft-white.165}", "$description": "Primary text and icons."},
    "text-secondary": {"$value": "{color.soft-white.438}", "$description": "Secondary text."},
    "text-tertiary": {"$value": "{color.soft-white.601}", "$description": "Non-essential text, disabled text, decorative glyphs."},
    "success": {
      "$value": "{color.green.453}",
      "$description": "Success state: icons, indicators, fills, and text on Surface and Surface Elevated."
    },
    "warning": {
      "$value": "{color.amber.469}",
      "$description": "Warning state: icons, indicators, fills, and text on Surface and Surface Elevated."
    },
    "error": {
      "$value": "{color.red.442}",
      "$description": "Error state: icons, indicators, fills, and text on Surface and Surface Elevated."
    },
    "info": {
      "$value": "{color.blue.439}",
      "$description": "Information state: icons, indicators, fills, and text on Surface and Surface Elevated."
    },
    "text-secondary-aa": {
      "$value": "{color.soft-white.434}",
      "$description": "Text Secondary meeting 4.5:1 on every surface (baseline is 4.49:1 on Surface Inset).",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "text-tertiary-aa": {
      "$value": "{color.text-secondary-aa}",
      "$description": "Soft White cannot hold a distinct tertiary tier that meets 4.5:1; essential tertiary text uses the Text Secondary accessible variant.",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "border-aa": {
      "$value": "{color.soft-white.543}",
      "$description": "Boundary color for interactive controls: ≥ 3:1 against every surface.",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "success-aa": {
      "$value": "{color.green.434}",
      "$description": "Success text meeting 4.5:1 on every surface.",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "warning-aa": {
      "$value": "{color.amber.434}",
      "$description": "Warning text meeting 4.5:1 on every surface.",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "error-aa": {
      "$value": "{color.red.433}",
      "$description": "Error text meeting 4.5:1 on every surface.",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "info-aa": {
      "$value": "{color.blue.432}",
      "$description": "Information text meeting 4.5:1 on every surface.",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "focus": {
      "$value": "{color.text-primary}",
      "$description": "Focus ring. ≥ 11.6:1 against every surface.",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "surface-inverse": {
      "$value": "{color.text-primary}",
      "$description": "Monochrome emphasis fill: primary buttons, checked controls, tooltips.",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "text-inverse": {
      "$value": "{color.surface}",
      "$description": "Text and glyphs on surface-inverse and on semantic fills.",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "fill-hover": {
      "$value": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.06, "hex": "#292927"},
      "$description": "State layer composited over any surface on hover.",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "fill-pressed": {
      "$value": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.1, "hex": "#292927"},
      "$description": "State layer composited over any surface while pressed.",
      "$extensions": {"carbon": {"status": "proposed"}}
    },
    "scrim": {
      "$value": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.32, "hex": "#292927"},
      "$description": "Modal backdrop behind D4 surfaces.",
      "$extensions": {"carbon": {"status": "proposed"}}
    }
  },
  "light": {
    "$description": "Ambient Lighting: one coherent environment. Light arrives broadly from above the screen plane.",
    "$extensions": {"carbon": {"status": "proposed"}},
    "ambient": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "alpha": 0.4, "hex": "#FFFFFF"},
      "$description": "Ambient illumination tint: the lit (upper) side of a surface."
    },
    "diffuse": {
      "$type": "gradient",
      "$value": [
        {"color": "{light.ambient}", "position": 0},
        {
          "color": {"colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "alpha": 0, "hex": "#FFFFFF"},
          "position": 0.5
        },
        {
          "color": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.025, "hex": "#292927"},
          "position": 1
        }
      ],
      "$description": "Diffuse falloff across a surface: lit top, neutral middle, gently shaded bottom. Applied top to bottom."
    },
    "edge": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "alpha": 0.72, "hex": "#FFFFFF"},
      "$description": "Edge highlight on surface and elevated fills."
    },
    "edge-inverse": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "alpha": 0.14, "hex": "#FFFFFF"},
      "$description": "Edge highlight on surface-inverse fills."
    },
    "occlusion": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.06, "hex": "#292927"},
      "$description": "Contact occlusion inside edges and recesses."
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Shadow layers. Colors use the theme's shadow ink at partial alpha.",
    "$extensions": {"carbon": {"status": "reference"}},
    "contact": {
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.1, "hex": "#292927"},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": "{elevation.contact.offset}",
        "blur": "{elevation.contact.blur}",
        "spread": {"value": 0, "unit": "px"}
      },
      "$description": "Contact shadow: tight occlusion where a resting surface meets the plane."
    },
    "ambient": {
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.12, "hex": "#292927"},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": "{elevation.2.offset}",
        "blur": "{elevation.2.blur}",
        "spread": {"value": 0, "unit": "px"}
      },
      "$description": "Ambient shadow: broad, soft occlusion around a raised body."
    },
    "floating": {
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.16, "hex": "#292927"},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": "{elevation.3.offset}",
        "blur": "{elevation.3.blur}",
        "spread": {"value": 0, "unit": "px"}
      },
      "$description": "Floating shadow: separation between a detached surface and the plane."
    },
    "inset": {
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.08, "hex": "#292927"},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": "{elevation.contact.offset}",
        "blur": "{elevation.contact.blur}",
        "spread": {"value": 0, "unit": "px"},
        "inset": true
      },
      "$description": "Inner occlusion of recessed (inset) regions.",
      "$extensions": {"carbon": {"status": "proposed"}}
    }
  },
  "depth": {
    "$type": "shadow",
    "$description": "Depth hierarchy D0–D4: complete shadow stacks. Pair with a bevel and a surface fill; never rely on shadow alone.",
    "$extensions": {"carbon": {"status": "reference"}},
    "0": {
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0.0, 0.0, 0.0], "alpha": 0, "hex": "#000000"},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 0, "unit": "px"},
        "blur": {"value": 0, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      },
      "$description": "D0 Foundation — no shadow."
    },
    "1": {
      "$value": [
        "{shadow.contact}",
        {
          "color": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.06, "hex": "#292927"},
          "offsetX": {"value": 0, "unit": "px"},
          "offsetY": "{elevation.1.offset}",
          "blur": "{elevation.1.blur}",
          "spread": {"value": 0, "unit": "px"}
        }
      ],
      "$description": "D1 Integrated."
    },
    "2": {"$value": ["{shadow.contact}", "{shadow.ambient}"], "$description": "D2 Raised."},
    "3": {
      "$value": [
        {
          "color": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.1, "hex": "#292927"},
          "offsetX": {"value": 0, "unit": "px"},
          "offsetY": "{elevation.3.near-offset}",
          "blur": "{elevation.3.near-blur}",
          "spread": {"value": 0, "unit": "px"}
        },
        "{shadow.floating}"
      ],
      "$description": "D3 Floating."
    },
    "4": {
      "$value": [
        {
          "color": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.14, "hex": "#292927"},
          "offsetX": {"value": 0, "unit": "px"},
          "offsetY": "{elevation.4.near-offset}",
          "blur": "{elevation.4.near-blur}",
          "spread": {"value": 0, "unit": "px"}
        },
        {
          "color": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.22, "hex": "#292927"},
          "offsetX": {"value": 0, "unit": "px"},
          "offsetY": "{elevation.4.offset}",
          "blur": "{elevation.4.blur}",
          "spread": {"value": 0, "unit": "px"}
        }
      ],
      "$description": "D4 Elevated."
    },
    "hover": {
      "$description": "Hover elevation: half a level up. Hover never turns a resting surface into a floating one.",
      "$extensions": {"carbon": {"status": "proposed"}},
      "1": {
        "$value": [
          "{shadow.contact}",
          {
            "color": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.09, "hex": "#292927"},
            "offsetX": {"value": 0, "unit": "px"},
            "offsetY": "{elevation.hover-1.offset}",
            "blur": "{elevation.hover-1.blur}",
            "spread": {"value": 0, "unit": "px"}
          }
        ],
        "$description": "D1 surface on hover."
      },
      "2": {
        "$value": [
          "{shadow.contact}",
          {
            "color": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.14, "hex": "#292927"},
            "offsetX": {"value": 0, "unit": "px"},
            "offsetY": "{elevation.hover-2.offset}",
            "blur": "{elevation.hover-2.blur}",
            "spread": {"value": 0, "unit": "px"}
          }
        ],
        "$description": "D2 surface on hover."
      }
    },
    "pressed": {
      "$value": "{shadow.contact}",
      "$description": "Resting surface while pressed: pushed down onto the plane, contact shadow only.",
      "$extensions": {"carbon": {"status": "proposed"}}
    }
  },
  "material": {
    "$type": "color",
    "$description": "Theme-specific Hybrid Material colors.",
    "$extensions": {"carbon": {"status": "proposed"}},
    "composite": {
      "weave-shade": {
        "$value": {"colorSpace": "srgb", "components": [0.1608, 0.1608, 0.1529], "alpha": 0.045, "hex": "#292927"},
        "$description": "Shaded tows of the Carbon Composite twill."
      },
      "weave-highlight": {
        "$value": {"colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "alpha": 0.35, "hex": "#FFFFFF"},
        "$description": "Lit tows of the Carbon Composite twill."
      }
    }
  }
}
